{
    "stations_csv": "./weathermetricsdata/src/weathermetricsdata/data/stations.csv",
    "station_id_col": "stid",
    "latitude_col": "latitude",
    "longitude_col": "longitude",
    "weather_dir": "./weathermetricsdata/src/weathermetricsdata/data/",
    "n_miles": 0,
    "direction": null,
    "max_stations": 10,
    "extra_station_ids":[] ,
    "indep_vars": [],
    "time_args": {
        "date_col": "Date_YYYYMMDD",
        "time_col": "nHOUR",
        "datetime_col": "datetime" },
    "agg_map": {
        "precip_depth_sum_mm": ["sum"]},    
    "period_freq": "1h",
    "rolling": true,
    "rolling_window": "240h",
    "lookback_days": 30,
    "first_lag_hours": 96,
    "years_back": 5,
    "bins": [-9999,20,40,60,80,100,9999],
    "labels": [0,1,2,3,4,5],
    "calculate_aux_features": false,
    "aux_resample_apply_to_primary": false,
    "aux_agg_map": {
        "precip_depth_sum_mm_sum": ["sum"],
        "air_temp_degrees_cels_mean": ["mean"]},
    "aux_rolling_windows": [7],
    "aux_output_mode": "both",
    "drop_date_stationid": true,
    "output_dir": "./weathermetricsdata/src/weathermetricsdata/output",
    "output_formats": ["csv", "parquet"],
    "output_prefix": "pipeline",   
    "chunk_size": 200000,
    "engine": "polars",
    "n_workers": 4    
}

